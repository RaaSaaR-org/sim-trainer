# Server + identity
NEODEM_SERVER_URL=http://192.168.178.76:3001
WORKER_ID=sim-trainer-mac-01
POLL_INTERVAL_SEC=5
HEARTBEAT_INTERVAL_SEC=30

# RustFS / S3 (twin scenes in, policy artifacts out)
RUSTFS_ENDPOINT=http://192.168.178.76:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET_TWINS=digital-twins
RUSTFS_BUCKET_MODELS=model-checkpoints

# Compute
TRAINING_DEVICE=cpu     # cpu | mps (Mac) | cuda (Linux GPU)

# Trainer: TRAINER_STUB=true forces the stub; else TRAINER selects stub|ppo|mjx|isaac
TRAINER=ppo
# TRAINER_STUB=true

# RL hyperparameters (also overridable per-job via job.hyperparameters)
TOTAL_TIMESTEPS=200000
N_ENVS=8

# --- Isaac Lab GPU RL locomotion (TRAINER=isaac) — Linux/CUDA host ONLY ---
# Trains a G1 walking gait in Isaac Sim/PhysX + rsl_rl over thousands of parallel
# envs, then exports a policy the MuJoCo locomotion gate scores. Requires Isaac Sim
# + Isaac Lab installed out-of-band (see README "GPU host deploy"); on the Mac the
# trainer raises a clear error — use TRAINER=ppo or TRAINER_STUB=true instead.
# TRAINER=isaac
# TRAINING_DEVICE=cuda
# N_ENVS=4096
# ISAAC_TASK=Isaac-Velocity-Flat-G1-v0
# MAX_ITERATIONS=1500
# NUM_STEPS_PER_ENV=24

# sim_evaluator (navigation env). Default resolves to the sibling repo:
#   ../robot-management-system/robot-agent/hardware/sim_evaluator
# Override only if your checkout layout differs.
# SIM_EVALUATOR_PATH=/abs/path/to/sim_evaluator
